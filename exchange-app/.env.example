# Copy to .env for local `netlify dev`. In production these are set as Netlify
# environment variables instead (Site configuration -> Environment variables).
# Never commit the real .env — it is gitignored.

# Supabase pooled (transaction-mode) Postgres connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres

# --- Password recovery email (plain SMTP; any provider works) ---
# Without these, "Forgot password?" answers "Password recovery is not set up yet."
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
# For Gmail this must be an App Password (Google Account -> Security -> 2-Step Verification -> App passwords), not your normal password.
SMTP_PASS=
# Optional. Defaults to: WZExchange <SMTP_USER>
SMTP_FROM=

# Public URL used to build the reset link in emails. Defaults to https://wzexchange.netlify.app
APP_URL=https://wzexchange.netlify.app
